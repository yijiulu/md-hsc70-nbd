; Steepest-descent energy minimisation in explicit OPC water
define          = -DPOSRES
integrator      = steep
emtol           = 500.0
emstep          = 0.01
nsteps          = 50000
nstlist         = 10
cutoff-scheme   = Verlet
pbc             = xyz
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = cutoff
rvdw            = 1.0
DispCorr        = EnerPres
constraints     = none
