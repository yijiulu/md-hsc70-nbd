; aaMD — NVT equilibration, heavy atoms of protein and ligand position-restrained
define                   = -DPOSRES
integrator               = md
dt                       = 0.002
mass-repartition-factor  = 3     ; 3 with HMR (Hopkins et al. 2015), 1 without; kept identical in all MD stages
nsteps                   = 50000
nstcalcenergy            = 100
nstenergy                = 500
nstlog                   = 500
nstxout-compressed       = 0
continuation             = no
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 6          ; GROMACS docs: 6 is needed for large time steps with virtual sites (HMR 4 fs + OPC)
lincs-iter               = 2          ; HMR 4 fs: required for stability of light Met S-CH3 carbons (Hopkins et al. 2015)
cutoff-scheme            = Verlet
pbc                      = xyz
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = cutoff
rvdw                     = 1.0
DispCorr                 = EnerPres
tcoupl                   = v-rescale
tc-grps                  = Protein_LIG Water_and_ions
tau-t                    = 0.1 0.1
ref-t                    = 300 300
pcoupl                   = no
gen-vel                  = yes
gen-temp                 = 300
gen-seed                 = -1
