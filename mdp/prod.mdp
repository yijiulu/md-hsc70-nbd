; aaMD — unrestrained NPT production (ff19SB-style: 10 A cutoff, PME, HMR 4 fs; Tian et al. 2020)
integrator               = md
dt                       = 0.004       ; 0.004 with HMR, 0.002 without
mass-repartition-factor  = 3
nsteps                   = 37500000
nstcalcenergy            = 100
nstenergy                = 2500   ; every 10 ps
nstlog                   = 2500
nstxout-compressed       = 2500   ; every 10 ps, protein + ligand only
compressed-x-grps        = Protein_LIG
continuation             = yes
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 6          ; GROMACS docs: 6 is needed for large time steps with virtual sites (HMR 4 fs + OPC)
lincs-iter               = 2          ; HMR 4 fs: required for stability of light Met S-CH3 carbons (Hopkins et al. 2015)
cutoff-scheme            = Verlet
pbc                      = xyz
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = cutoff
rvdw                     = 1.0
DispCorr                 = EnerPres
tcoupl                   = v-rescale
tc-grps                  = Protein_LIG Water_and_ions
tau-t                    = 0.1 0.1
ref-t                    = 300 300
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau-p                    = 5.0
ref-p                    = 1.0
compressibility          = 4.5e-5
gen-vel                  = no
