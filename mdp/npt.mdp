; aaMD — NPT equilibration, heavy atoms of protein and ligand position-restrained
define                   = -DPOSRES
integrator               = md
dt                       = 0.002
mass-repartition-factor  = 3
nsteps                   = 500000
nstcalcenergy            = 100
nstenergy                = 500
nstlog                   = 5000
nstxout-compressed       = 0
continuation             = yes
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 6          ; GROMACS docs: 6 is needed for large time steps with virtual sites (HMR 4 fs + OPC)
lincs-iter               = 2          ; HMR 4 fs: required for stability of light Met S-CH3 carbons (Hopkins et al. 2015)
cutoff-scheme            = Verlet
pbc                      = xyz
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = cutoff
rvdw                     = 1.0
DispCorr                 = EnerPres
tcoupl                   = v-rescale
tc-grps                  = Protein_LIG Water_and_ions
tau-t                    = 0.1 0.1
ref-t                    = 300 300
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau-p                    = 5.0        ; GROMACS default
ref-p                    = 1.0
compressibility          = 4.5e-5     ; water, bar^-1
refcoord-scaling         = com
gen-vel                  = no
