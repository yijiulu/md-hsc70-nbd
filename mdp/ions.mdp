; Minimal GROMACS MDP for ion addition (grompp + genion)
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 500
nstlist         = 1
cutoff-scheme   = Verlet
ns_type         = grid
coulombtype     = cutoff
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
